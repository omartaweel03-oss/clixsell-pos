<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- DEBUG BUILDS ONLY: allows plain HTTP to the ClixSell backend on the local network
         (e.g. http://192.168.1.20:8080/api) for development and demos. Release builds do NOT
         include this, so they require HTTPS (Android's default). See ANDROID_PHASE1.md. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
